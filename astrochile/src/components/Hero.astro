---
// Hero component for mobile
---

<section class="relative bg-light-bg overflow-hidden">
  <!-- fondo doodle bajo el título -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none z-0">
    <div class="absolute inset-0 opacity-20" style={`background-image: url('${import.meta.env.BASE_URL}images/iade-doodle-red.svg'); background-repeat: repeat; background-size: 120px 120px; background-position: center; will-change: background-position; animation: doodle-drift 60s linear infinite;`}></div>
  </div>

  <div class="relative z-[1] max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <div class="text-center">
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-primary leading-snug tracking-tight mb-3">
        Conviértete en un profesional de oficio<br>
        <span class="text-yellow-400">Escuelas IADE Chile</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-700 mb-6 max-w-2xl mx-auto">
        Formación práctica y rápida, 100% técnica, en modalidad <strong class="text-primary">online</strong>.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a 
          href={`${import.meta.env.BASE_URL}#lead-form`} 
          class="bg-primary text-white px-5 py-2.5 rounded-lg font-bold text-base leading-snug hover:bg-primary/90 transition-all duration-200 transform hover:scale-[1.02] shadow-lg hover:shadow-xl text-center"
        >
          Contactame con un asesor
        </a>
        <a 
          href="https://www.escuelasiade.com.ar/iade_campus_exp/login.php" 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-primary text-white px-5 py-2.5 rounded-lg font-bold text-base leading-snug hover:bg-primary/90 transition-all duration-200 transform hover:scale-[1.02] shadow-lg hover:shadow-xl text-center"
        >
          Acceder al Campus
        </a>
      </div>
    </div>
  </div>
</section> 
