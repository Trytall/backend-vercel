---
// WhatsApp floating button component
---

<div class="wa-fixed z-50" style="padding-bottom: env(safe-area-inset-bottom)">
  <div class="relative flex items-center gap-2">
    <!-- Burbuja con texto (arriba en móvil, lateral en desktop) -->
    <div id="wa-bubble" class="absolute -top-12 right-0 sm:static sm:top-auto sm:left-auto sm:right-auto max-w-[78vw] sm:max-w-xs bg-gradient-to-br from-green-700 to-emerald-600 text-white rounded-2xl px-3 sm:px-4 py-2.5 shadow-xl flex items-start gap-2 transition-all duration-300 opacity-0 will-change-[opacity,transform]">
      <div class="text-[11px] sm:text-sm leading-snug font-medium">¡Contactanos!</div>
      <button id="wa-bubble-close" class="ml-1 -mr-1 text-white/90 hover:text-white rounded-full p-1 focus:outline-none focus:ring-2 focus:ring-white/60 focus:ring-offset-1 focus:ring-offset-green-700" aria-label="Cerrar aviso de WhatsApp">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <div class="absolute right-3 sm:-right-1.5 top-full sm:top-1/2 sm:-translate-y-1/2 w-2.5 h-2.5 sm:w-3 sm:h-3 rotate-45 bg-gradient-to-br from-green-700 to-emerald-600"></div>
    </div>

    <!-- Botón principal -->
    <a 
      href="https://wa.me/5491130112419?text=Hola%20IADE,%20quiero%20recibir%20información%20sobre%20sus%20cursos" 
      target="_blank" 
      rel="noopener noreferrer"
      class="wa-btn relative isolate flex items-center justify-center w-12 h-12 sm:w-16 sm:h-16 rounded-full text-white shadow-[0_10px_30px_rgba(16,185,129,0.35)] hover:shadow-[0_14px_40px_rgba(16,185,129,0.45)] transition-all duration-300 hover:scale-110 animate-whatsapp-pulse ring-1 ring-white/20 bg-gradient-to-br from-emerald-500 to-green-600"
      aria-label="Contactar por WhatsApp"
    >
      <!-- Glow -->
      <span class="pointer-events-none absolute -z-10 inset-0 rounded-full bg-emerald-400/40 blur-xl scale-125"></span>
      <!-- Icono -->
      <svg class="w-5 h-5 sm:w-7 sm:h-7" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.661a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
      </svg>
    </a>
  </div>

  <style>
    .wa-fixed { position: fixed; bottom: 1rem; right: max(12px, env(safe-area-inset-right)); left: auto; }
    @media (min-width: 640px){ .wa-fixed { bottom: 1.5rem; right: max(16px, env(safe-area-inset-right)); } }

    @keyframes whatsapp-pulse {
      0%, 100% { transform: scale(1); box-shadow: 0 10px 20px rgba(16,185,129,0.25) }
      50% { transform: scale(1.06); box-shadow: 0 12px 28px rgba(16,185,129,0.40) }
    }
    .animate-whatsapp-pulse { animation: whatsapp-pulse 2.2s ease-in-out infinite; }

    @keyframes ringPulse {
      0% { box-shadow: 0 0 0 0 rgba(16,185,129,0.35); }
      70% { box-shadow: 0 0 0 14px rgba(16,185,129,0); }
      100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
    }
    .wa-btn:hover { animation-name: whatsapp-pulse, ringPulse; animation-duration: 2.2s, 1.8s; animation-iteration-count: infinite, infinite; animation-timing-function: ease-in-out, ease-out; }

    @media (prefers-reduced-motion: reduce) {
      .animate-whatsapp-pulse, .wa-btn:hover { animation: none !important; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const bubble = document.getElementById('wa-bubble');
      const closeBtn = document.getElementById('wa-bubble-close');
      const STORAGE_KEY = 'wa_bubble_last_closed_at_ms';
      const REOPEN_MS = 120000; // 2 minutos

      function hideBubble() {
        if (!bubble) return;
        bubble.style.opacity = '0';
        bubble.style.transform = 'translateY(4px)';
        bubble.style.pointerEvents = 'none';
        setTimeout(() => { if (bubble) bubble.style.display = 'none'; }, 250);
      }

      function showBubble() {
        if (!bubble) return;
        bubble.style.display = 'flex';
        bubble.style.opacity = '0';
        bubble.style.transform = 'translateY(4px)';
        requestAnimationFrame(() => {
          bubble.style.opacity = '1';
          bubble.style.transform = 'translateY(0)';
          bubble.style.pointerEvents = 'auto';
        });
      }

      function scheduleReopen(delay) {
        setTimeout(() => {
          const last = Number(localStorage.getItem(STORAGE_KEY) || 0);
          const elapsed = Date.now() - last;
          if (elapsed >= REOPEN_MS) {
            showBubble();
          } else {
            scheduleReopen(REOPEN_MS - elapsed);
          }
        }, Math.max(0, delay));
      }

      const lastClosed = Number(localStorage.getItem(STORAGE_KEY) || 0);
      if (lastClosed > 0) {
        const elapsed = Date.now() - lastClosed;
        if (elapsed >= REOPEN_MS) {
          showBubble();
        } else {
          hideBubble();
          scheduleReopen(REOPEN_MS - elapsed);
        }
      } else {
        showBubble();
        setTimeout(() => {
          const style = window.getComputedStyle(bubble);
          if (style && style.display !== 'none') hideBubble();
        }, 8000);
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          localStorage.setItem(STORAGE_KEY, String(Date.now()));
          hideBubble();
          scheduleReopen(REOPEN_MS);
        });
      }
    });
  </script>
</div> 
