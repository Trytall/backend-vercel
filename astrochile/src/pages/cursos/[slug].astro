---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import cursos, { type Curso } from '../../data/cursos.ts';

export async function getStaticPaths() {
  return cursos.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const curso: Curso | undefined = cursos.find((c) => c.slug === slug);
if (!curso) { throw new Error('Curso no encontrado'); }

function sedeToSlug(sede: string = ''): string {
  return sede
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}
---

<Layout title={`${curso.nombre} - Escuelas IADE`} description={curso.descripcion}>
  <Header />

  <section class="pt-24 pb-12 bg-light-bg">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-8 items-center">
        <div>
          <h1 class="text-3xl lg:text-4xl font-bold text-primary mb-4 tracking-tight">{curso.nombre}</h1>
          <p class="text-lg text-gray-700 mb-6">{curso.descripcion}</p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {curso.modalidades.map((m) => (
              <a
                href={m.tipo === 'online' ? `/cursos/${curso.slug}/online` : `/cursos/${curso.slug}/${sedeToSlug(m.sede ?? '')}`}
                class="bg-white border border-primary/20 hover:border-primary px-4 py-3 rounded-lg shadow-sm hover:shadow-md transition flex items-center justify-between"
              >
                <div>
                  <div class="font-semibold text-primary">{m.tipo === 'online' ? 'Online' : `Presencial ${m.sede ? '· ' + m.sede : ''}`}</div>
                  <div class="text-sm text-gray-600">{m.duracion || 'Duración a confirmar'}</div>
                </div>
                <div class="text-sm font-bold text-emerald-600">{m.precio || 'Consultar'}</div>
              </a>
            ))}
          </div>

          <div class="flex gap-3 mt-6">
            <a href={`/?curso=${curso.slug}`} class="bg-primary text-white px-5 py-3 rounded-lg font-bold hover:bg-primary/90 transition">¡Inscribirme ahora!</a>
            <a href={`https://wa.me/5491130112419?text=Hola, me interesa el ${curso.nombre}`} target="_blank" rel="noopener noreferrer" class="bg-green-600 text-white px-5 py-3 rounded-lg font-bold hover:bg-green-700 transition">WhatsApp</a>
          </div>
        </div>
        <div class="flex justify-center lg:justify-end">
          <img src={curso.imagen || '/images/logo.png'} alt={curso.nombre} class="max-w-sm lg:max-w-md rounded-lg shadow-lg" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-primary mb-3">Temario</h2>
      <p class="text-gray-600">Seleccioná una versión (Online o Presencial por sede) para ver el temario específico.</p>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />
</Layout>


