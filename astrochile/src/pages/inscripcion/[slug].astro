---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import courses from '../../data/courses.js';

export function getStaticPaths() {
  return courses.map(c => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const course = courses.find(c => c.slug === slug);
if (!course) throw new Error('Curso no encontrado');

// Leer modalidad y sede desde query
const url = new URL(Astro.request.url);
const modalidadQS = (url.searchParams.get('modalidad') || '').toLowerCase();
const sedeQS = (url.searchParams.get('sede') || '').toLowerCase();
const isOnline = modalidadQS ? modalidadQS === 'online' : (course.modality || '').toLowerCase().includes('online');
const sedeMap = { moron: 'Morón', lomas: 'Lomas de Zamora', avellaneda: 'Avellaneda' };
const sedeVista = sedeMap[sedeQS] || '';
---

<Layout title={`Inscripción | ${course.title}`} description={`Elegí cómo inscribirte al ${course.title}. Pago directo o asesor personalizado.`}>
  <Header />

  <!-- Hero / Title -->
  <section id="insc-root" data-course-title={course.title} class="pt-12 pb-8 bg-light-bg text-center">
    <h1 class="text-3xl md:text-4xl font-extrabold text-primary mb-4">¡Elegí cómo querés inscribirte!</h1>
    {isOnline ? (
      <p class="text-gray-700 max-w-2xl mx-auto">Tenés opción de pago directo para comenzar tu curso online ahora mismo.</p>
    ) : (
      <p class="text-gray-700 max-w-2xl mx-auto">Para cursos presenciales coordiná tu inscripción con un asesor de la sede seleccionada.</p>
    )}
    {!isOnline && sedeVista && (
      <div class="mt-3 inline-block bg-primary/10 text-primary px-3 py-1 rounded">Sede: <strong>{sedeVista}</strong></div>
    )}
  </section>

  <!-- Options -->
  <section class={`py-12 bg-white`}>
    <div class={`max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid ${isOnline ? 'md:grid-cols-2' : 'md:grid-cols-1'} gap-8`}>
      {isOnline && (
        <div class="border-2 border-red-600 rounded-xl p-8 shadow-lg flex flex-col bg-red-50">
          <div class="text-4xl mb-4 text-center">💳</div>
          <h2 class="text-xl font-semibold mb-2 text-center">Pago con MercadoPago</h2>
          <p id="precioDesde" class="text-primary font-bold text-lg mb-6 text-center">Desde $150.000</p>
          <p class="text-gray-600 mb-6">Inscribite ahora mismo y accedé inmediatamente a tu curso. Pago seguro con MercadoPago.</p>

          <!-- Payment Plans -->
          <div class="space-y-4 mb-6">
            <button class="w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-3 rounded-lg flex items-center justify-between px-4" id="btnContado">
              <span>Pago al contado</span>
              <span class="precio-plan">$150.000</span>
            </button>
            <button class="w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-3 rounded-lg flex items-center justify-between px-4" id="btn3Cuotas">
              <span>3 cuotas</span>
              <span class="precio-plan">$240.000</span>
            </button>
            <button class="w-full bg-green-500 hover:bg-green-600 text-white font-semibold py-3 rounded-lg flex items-center justify-between px-4" id="btn6Cuotas">
              <span>6 cuotas</span>
              <span class="precio-plan">$300.000</span>
            </button>
          </div>

          <ul class="text-sm text-gray-600 space-y-1 mt-auto">
            <li>✅ Acceso inmediato al curso</li>
            <li>✅ Acceso permanente al material</li>
            <li>✅ Certificado oficial incluido</li>
            <li>✅ Pago seguro con Mercado Pago</li>
            <li>✅ Sin comisiones adicionales</li>
          </ul>
        </div>
      )}

      <!-- Asesor Option -->
      <div class="border-2 border-red-600 rounded-xl p-8 shadow-lg flex flex-col bg-red-50">
        <div class="text-4xl mb-4 text-center">👨‍💼</div>
        <h2 class="text-xl font-semibold mb-2 text-center">Contacto con Asesor</h2>
        <p class="text-primary font-bold text-lg mb-6 text-center">{isOnline ? 'Consultar' : 'Inscripción presencial'}</p>
        <p class="text-gray-600 mb-6">Un asesor te contactará inmediatamente para resolver todas tus dudas y ayudarte en la inscripción.</p>

        {!isOnline && sedeVista && (
          <div class="mb-6 text-center">
            <div class="inline-block bg-primary/10 text-primary px-3 py-1 rounded">Sede: <strong>{sedeVista}</strong></div>
          </div>
        )}

        <ul class="text-sm text-gray-600 space-y-1 mb-6">
          <li>✅ Atención personalizada</li>
          <li>✅ Resolución de dudas</li>
          <li>✅ Planes de pago flexibles</li>
          <li>✅ Acceso permanente incluido</li>
          <li>✅ Asesoramiento completo</li>
        </ul>
        <button class="bg-primary hover:bg-primary/90 text-white font-semibold py-3 rounded-lg w-full mt-auto" id="contactarAsesorBtn">Contactar por WhatsApp 👨‍💼</button>
      </div>
    </div>
  </section>

  <!-- Summary Box -->
  <section class="py-12 bg-light-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 bg-white rounded-xl shadow p-6 border-2 border-red-600">
      <h3 class="text-lg font-semibold text-center mb-6">Resumen de tu inscripción</h3>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-gray-50 p-4 rounded-lg">
          <h4 class="font-semibold text-gray-700 mb-3">Datos Personales</h4>
          <div id="resumenDatos" class="text-sm text-gray-600 space-y-2"></div>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h4 class="font-semibold text-gray-700 mb-3">Cursos Seleccionados</h4>
          <div id="resumenCursos" class="text-sm text-gray-600"></div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />

  <script>
    const TEST_PRICE = false;
    const TEST_AMOUNT = 1;

    function params() { return Object.fromEntries(new URLSearchParams(location.search)); }

    const data = params();
    const resumenDatos = document.getElementById('resumenDatos');
    const resumenCursos = document.getElementById('resumenCursos');
    const fallbackCourse = document.getElementById('insc-root')?.dataset.courseTitle || '';
    const cursosTexto = data.cursos || fallbackCourse;
    const sedeMap = { moron: 'Morón', lomas: 'Lomas de Zamora', avellaneda: 'Avellaneda' };
    const sedeVista = sedeMap[(data.sede || '').toLowerCase()] || '';
    const isOnline = (data.modalidad || '').toLowerCase() === 'online';

    if (resumenDatos) {
      const datosHTML = `
        <div><strong>Nombre:</strong> ${data.nombre || 'No especificado'}</div>
        <div><strong>DNI:</strong> ${data.dni || 'No especificado'}</div>
        <div><strong>Email:</strong> ${data.email || 'No especificado'}</div>
        <div><strong>Teléfono:</strong> ${data.telefono || 'No especificado'}</div>
        <div><strong>Provincia:</strong> ${data.provincia || 'No especificado'}</div>
        <div><strong>Localidad:</strong> ${data.localidad || 'No especificado'}</div>
        <div><strong>Modalidad:</strong> ${data.modalidad || 'Online'}</div>
        ${!isOnline && sedeVista ? `<div><strong>Sede:</strong> ${sedeVista}</div>` : ''}
      `;
      resumenDatos.innerHTML = datosHTML;
    }
    if (resumenCursos) { resumenCursos.innerHTML = `<div class="bg-primary/10 text-primary px-3 py-2 rounded">${cursosTexto}</div>`; }

    // Persistencia (para retorno de pago o WA)
    (function persistInicial() {
      const preliminar = { nombre: data.nombre||'', dni: data.dni||'', email: data.email||'', telefono: data.telefono||'', provincia: data.provincia||'', localidad: data.localidad||'', curso: cursosTexto, sede: sedeVista };
      try { const prev = sessionStorage.getItem('datosPago'); if (!prev || prev !== JSON.stringify(preliminar)) { sessionStorage.setItem('datosPago', JSON.stringify(preliminar)); } } catch {}
    })();

    // reCAPTCHA v3
    const SITE_KEY = '6Ld_Uq8rAAAAAA7J5Mfy817Tn__ybWtIYLeihOqq';
    (function loadRecaptcha(){
      if (typeof window === 'undefined') return;
      if (window.grecaptcha) return;
      const s = document.createElement('script');
      s.src = `https://www.google.com/recaptcha/api.js?render=${SITE_KEY}`;
      s.async = true;
      document.head.appendChild(s);
    })();

    function waitForRecaptchaReady(timeoutMs = 6000) {
      return new Promise((resolve, reject) => {
        const start = Date.now();
        (function check(){
          if (typeof grecaptcha !== 'undefined' && grecaptcha.execute) return resolve();
          if (Date.now() - start > timeoutMs) return reject(new Error('recaptcha_not_ready'));
          setTimeout(check, 100);
        })();
      });
    }

    async function fetchRecaptchaToken() {
      // 1) Intentar recuperar por query o sessionStorage
      try {
        const tokenFieldQS = new URLSearchParams(location.search).get('recaptcha_token');
        if (tokenFieldQS) return tokenFieldQS;
        const stored = sessionStorage.getItem('recaptcha_token');
        if (stored) return stored;
      } catch {}
      // 2) Generar un token nuevo
      try {
        await waitForRecaptchaReady();
        const token = await grecaptcha.execute(SITE_KEY, { action: 'pay_inscripcion' });
        try { sessionStorage.setItem('recaptcha_token', token); } catch {}
        return token;
      } catch {}
      return '';
    }

    async function pagar(plan) {
      if (!isOnline) return; // seguridad extra
      let amount; let description;
      switch(plan){ case 'contado': amount=150000; description='Pago al contado'; break; case '3cuotas': amount=240000; description='3 cuotas'; break; case '6cuotas': amount=300000; description='6 cuotas'; break; default: amount=150000; description='Pago al contado'; }
      if (TEST_PRICE) amount = TEST_AMOUNT;
      const overrideStr = (data.precioTest || data.precio || '').toString().replace(',', '.');
      const override = parseFloat(overrideStr); if (!Number.isNaN(override) && override>0) amount = override;

      // Guardar datos en sessionStorage para cuando regrese del pago
      try {
        sessionStorage.setItem('datosPago', JSON.stringify({
          nombre: data.nombre || '',
          dni: data.dni || '',
          email: data.email || '',
          telefono: data.telefono || '',
          provincia: data.provincia || '',
          localidad: data.localidad || '',
          curso: cursosTexto,
          modalidad: data.modalidad || 'Online',
          monto: amount,
          plan: plan
        }));
      } catch (e) {
        console.error('Error guardando datos:', e);
      }

      try {
        const buttons = document.querySelectorAll('button'); 
        buttons.forEach(b => b.disabled = true);
        
        // Crear preferencia de pago - estructura mínima
        const preference = {
          items: [{
            title: cursosTexto || 'Curso IADE',
            quantity: 1,
            currency_id: 'ARS',
            unit_price: amount
          }],
          back_urls: {
            success: window.location.origin + '/pago-exitoso',
            failure: window.location.origin + '/pago-fallido',
            pending: window.location.origin + '/pago-pendiente'
          },
          external_reference: `inscripcion_${Date.now()}`
        };

        // Debug: mostrar datos que se envían
        console.log('Datos de preferencia:', preference);
        console.log('Token MP:', 'APP_USR-7278900707798742-110117-84d48eff52400bed16c532ee0d698c89-2085180642');
        
        // Crear preferencia usando la API de MercadoPago
        const response = await fetch('https://api.mercadopago.com/checkout/preferences', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': 'Bearer APP_USR-7278900707798742-110117-84d48eff52400bed16c532ee0d698c89-2085180642'
          },
          body: JSON.stringify(preference)
        });
        
        console.log('Response status:', response.status);
        console.log('Response headers:', response.headers);
        
        if (!response.ok) {
          const errorText = await response.text();
          console.error('Error response:', errorText);
          throw new Error(`Error HTTP: ${response.status} - ${errorText}`);
        }
        
        const result = await response.json();
        console.log('Preferencia creada:', result);
        
        if (result.id) {
          // Redirigir directamente al checkout de MercadoPago
          window.location.href = `https://www.mercadopago.com.ar/checkout/v1/redirect?pref_id=${result.id}`;
        } else {
          throw new Error('No se pudo crear la preferencia');
        }
        
        buttons.forEach(b => b.disabled = false);
      } catch (e) {
        console.error('Error al crear preferencia:', e);
        alert('Error al procesar el pago. Por favor, intenta nuevamente.');
        const buttons = document.querySelectorAll('button');
        buttons.forEach(b => b.disabled = false);
      }
    }

    function contactarAsesor() {
      const mensaje = `Hola IADE! Me interesa el curso de ${cursosTexto}.\n\nModalidad: ${data.modalidad || 'Online'}\n\nMis datos:\nNombre: ${data.nombre || ''}\nDNI: ${data.dni || ''}\nEmail: ${data.email || ''}\nTeléfono: ${data.telefono || ''}\nProvincia: ${data.provincia || ''}\nLocalidad: ${data.localidad || ''}\n\n¿Podrían brindarme más información sobre el curso?`;
      const url = `https://wa.me/5491130112419?text=${encodeURIComponent(mensaje)}`;
      window.open(url, '_blank');
    }

    // Listeners
    document.getElementById('btnContado')?.addEventListener('click', () => pagar('contado'));
    document.getElementById('btn3Cuotas')?.addEventListener('click', () => pagar('3cuotas'));
    document.getElementById('btn6Cuotas')?.addEventListener('click', () => pagar('6cuotas'));
    document.getElementById('contactarAsesorBtn')?.addEventListener('click', (e) => { e.preventDefault(); contactarAsesor(); });
  </script>
</Layout>

