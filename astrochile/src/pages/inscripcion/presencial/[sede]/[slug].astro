---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import WhatsAppButton from '../../../../components/WhatsAppButton.astro';
import cursos from '../../../../data/cursos.js';
import { getSedeConfig } from '../../../../data/sedes.js';

const { sede, slug } = Astro.params;

const sedeMap = {
  moron: {
    name: 'Morón',
    address: 'Alte. Brown 851, Galería Paseo Venecia 2° Piso, Morón',
    phone: '+54 9 11 2658-9218',
    whatsapp: '+54 9 11 2658-9218',
    email: 'info@escuelaiadezonaoeste.com.ar',
    hours: 'Lunes a Viernes 9:00 - 18:00',
    mapsEmbed: 'https://www.google.com/maps?q=Alte.+Brown+851%2C+Galer%C3%ADa+Paseo+Venecia+2%C2%B0+Piso%2C+Mor%C3%B3n&output=embed'
  },
  lomas: {
    name: 'Lomas de Zamora',
    address: 'Mariano Boedo 314, Lomas de Zamora, Argentina',
    phone: '+54 11 15-2260-8327',
    whatsapp: '011 15-2260-8327',
    email: 'info@escuelaiadezonaoeste.com.ar',
    hours: 'Lunes a Viernes 9:00 - 18:00',
    mapsEmbed: 'https://www.google.com/maps?q=Mariano+Boedo+314%2C+Lomas+de+Zamora%2C+Argentina&output=embed'
  },
      avellaneda: {
      name: 'Avellaneda',
      address: 'Av. Bartolomé Mitre 476, B1870 Avellaneda, Provincia de Buenos Aires',
      phone: '011 15-7072-5467',
      whatsapp: '011 15-7072-5467',
      email: 'escuelaiadeavellaneda@gmail.com',
      hours: 'Lunes a Viernes 9:00 - 18:00',
      mapsEmbed: 'https://www.google.com/maps?q=Av.+Bartolom%C3%A9+Mitre+476%2C+B1870+Avellaneda%2C+Provincia+de+Buenos+Aires&output=embed'
    }
};

export function getStaticPaths() {
  // mismas combinaciones que usamos en páginas de cursos presenciales
  const moron = new Set([
    'curso-de-instalaciones-electricas-y-motores-electricos',
    'curso-de-refrigeracion-y-aire-acondicionado',
    'curso-de-auxiliar-de-emergencias-medicas-sanitarias',
    'curso-de-reparacion-de-celulares',
    'curso-de-alarmas-y-camaras-de-seguridad',
    'curso-de-auxiliar-de-farmacia',
    'curso-de-asistente-de-enfermeria',
    'curso-de-auxiliar-en-cardiologia'
  ]);
  const lomas = new Set([
    'curso-de-asistente-de-enfermeria',
    'curso-de-extraccionista-y-auxiliar-de-bioquimico-de-laboratorio',
    'curso-de-auxiliar-de-emergencias-medicas-sanitarias',
    'curso-de-auxiliar-de-farmacia',
    'curso-de-reparacion-de-celulares',
    'curso-de-instalaciones-electricas-y-motores-electricos',
    'curso-de-refrigeracion-y-aire-acondicionado',
    'curso-de-plasma-rico-en-plaquetas',
    'curso-de-electricidad-y-electronica-industrial'
  ]);
  const avellaneda = new Set([
    'curso-de-asistente-de-enfermeria',
    'curso-de-auxiliar-de-emergencias-medicas-sanitarias',
    'curso-de-auxiliar-de-farmacia',
    'curso-de-extraccionista-y-auxiliar-de-bioquimico-de-laboratorio'
  ]);

  const valid = [];
  cursos.forEach(c => {
    const s = c.slug;
    if (moron.has(s)) valid.push({ params: { sede: 'moron', slug: s } });
    if (lomas.has(s)) valid.push({ params: { sede: 'lomas', slug: s } });
    if (avellaneda.has(s)) valid.push({ params: { sede: 'avellaneda', slug: s } });
  });
  return valid;
}

const sedeCfg = sedeMap[sede];
const curso = cursos.find(c => c.slug === slug);
if (!sedeCfg || !curso) throw new Error('Sede o curso no válidos');
---

<Layout title={`Inscripción Presencial | ${curso.titulo} - ${sedeCfg.name}`} description={`Coordiná tu inscripción presencial en ${sedeCfg.name}.`}>
  <Header />

  <!-- Hero -->
  <section class="pt-12 pb-6 bg-light-bg text-center">
    <h1 class="text-3xl md:text-4xl font-extrabold text-primary mb-2">Inscripción Presencial</h1>
    <p class="text-gray-700">{curso.titulo} — Sede {sedeCfg.name}</p>
  </section>

  <!-- Info + Contact options -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-8">
      <!-- Tarjeta de sede -->
      <div class="border border-primary rounded-xl overflow-hidden shadow-lg">
        <div class="p-5 border-b border-primary/20">
          <h2 class="text-xl font-semibold">Información de la sede</h2>
        </div>
        <div class="aspect-video bg-gray-100">
          <iframe src={sedeCfg.mapsEmbed} class="w-full h-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        <div class="p-6 space-y-2 text-gray-700">
          <div><span class="font-semibold">📍 Ubicación:</span> {sedeCfg.address}</div>
          <div><span class="font-semibold">🕒 Horarios:</span> {sedeCfg.hours}</div>
          <div><span class="font-semibold">📞 Teléfono:</span> {sedeCfg.phone}</div>
          {sedeCfg.whatsapp && (
            <div><span class="font-semibold">💬 WhatsApp:</span> {sedeCfg.whatsapp}</div>
          )}
          {sedeCfg.email && (
            <div><span class="font-semibold">📧 Email:</span> <a href="mailto:{sedeCfg.email}" class="text-primary hover:underline">{sedeCfg.email}</a></div>
          )}
        </div>
      </div>

      <!-- Contacto por WhatsApp -->
      <div class="border border-primary rounded-xl p-8 shadow-lg flex flex-col">
        <div class="text-4xl mb-4 text-center">👨‍💼</div>
        <h2 class="text-xl font-semibold mb-2 text-center">Contacto con Asesor</h2>
        <p class="text-gray-600 mb-6 text-center">Coordiná horarios, inicios y requisitos con un asesor de {sedeCfg.name}.</p>
        <button class="bg-primary hover:bg-primary/90 text-white font-semibold py-3 rounded-lg w-full mt-auto" id="contactarAsesorBtn">Contactar por WhatsApp</button>
      </div>
    </div>
  </section>

  <!-- Resumen -->
  <section class="py-12 bg-light-bg">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 bg-white rounded-xl shadow p-6">
      <h3 class="text-lg font-semibold text-center mb-6">Resumen de tus datos</h3>
      <div id="resumenDatos" class="grid md:grid-cols-2 gap-6 text-sm text-gray-700"></div>
    </div>
  </section>

  <Footer />
  <WhatsAppButton />

  <script define:vars={{ sedeConfig: JSON.stringify(sedeMap[sede]) }}>
    const sedeNombres = { moron:'Morón', lomas:'Lomas de Zamora', avellaneda:'Avellaneda' };
    function params(){ return Object.fromEntries(new URLSearchParams(location.search)); }
    const data = params();
    const sedeNombre = sedeNombres[(data.sede||'').toLowerCase()] || '';
    const resumen = document.getElementById('resumenDatos');
    const curso = new URLSearchParams(location.search).get('cursos') || document.querySelector('h1')?.textContent || '';

    // Parsear sedeConfig de JSON string a objeto
    let sedeConfigObj;
    try {
      sedeConfigObj = JSON.parse(sedeConfig);
    } catch (e) {
      console.error('Error parseando sedeConfig:', e);
      sedeConfigObj = null;
    }

    if (resumen) {
      resumen.innerHTML = `
        <div><strong>Nombre:</strong> ${data.nombre || '—'}</div>
        <div><strong>DNI:</strong> ${data.dni || '—'}</div>
        <div><strong>Email:</strong> ${data.email || '—'}</div>
        <div><strong>Teléfono:</strong> ${data.telefono || '—'}</div>
        <div><strong>Provincia:</strong> ${data.provincia || '—'}</div>
        <div><strong>Localidad:</strong> ${data.localidad || '—'}</div>
        <div><strong>Curso:</strong> ${curso || '—'}</div>
        ${sedeNombre ? `<div><strong>Sede:</strong> ${sedeNombre}</div>` : ''}
      `;
    }

    document.getElementById('contactarAsesorBtn')?.addEventListener('click', function(){
      console.log('Botón WhatsApp clickeado');
      console.log('sedeConfig (string):', sedeConfig);
      console.log('sedeConfigObj (objeto):', sedeConfigObj);
      console.log('Tipo de sedeConfigObj:', typeof sedeConfigObj);
      console.log('sedeConfigObj.whatsapp:', sedeConfigObj?.whatsapp);
      
      const msg = `Hola IADE! Me interesa el curso de ${curso}.\n\nModalidad: Presencial\nSede: ${sedeNombre}\n\nMis datos:\nNombre: ${data.nombre || ''}\nDNI: ${data.dni || ''}\nEmail: ${data.email || ''}\nTeléfono: ${data.telefono || ''}\nProvincia: ${data.provincia || ''}\nLocalidad: ${data.localidad || ''}\n\n¿Podrían brindarme más información sobre el curso?`;
      
      if (sedeConfigObj && sedeConfigObj.whatsapp) {
        // Formatear número para WhatsApp: quitar +, espacios y guiones, agregar 54 si no está
        let whatsappNumber = sedeConfigObj.whatsapp.replace(/[^0-9]/g, '');
        
        // Si no empieza con 54, agregarlo
        if (!whatsappNumber.startsWith('54')) {
          whatsappNumber = '54' + whatsappNumber;
        }
        
        console.log('Número WhatsApp formateado:', whatsappNumber);
        const url = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
        console.log('URL WhatsApp:', url);
        window.open(url, '_blank');
      } else {
        console.error('No se pudo obtener el número de WhatsApp');
        console.error('sedeConfigObj existe:', !!sedeConfigObj);
        console.error('sedeConfigObj.whatsapp existe:', !!sedeConfigObj?.whatsapp);
        alert('Error: No se pudo obtener el número de WhatsApp para esta sede');
      }
    });
  </script>
</Layout>