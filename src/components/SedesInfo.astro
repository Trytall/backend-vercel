---
// Componente para mostrar información de todas las sedes
import { getAllSedes, getWhatsAppNumberForLink } from '../data/sedes.js';

const sedes = getAllSedes();
---

<section id="sedes" class="py-16 lg:py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl lg:text-4xl font-bold text-secondary mb-4">
        🏫 Nuestras Sedes
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Encuentra la sede más cercana a tu ubicación y conoce todos nuestros centros de formación
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      {sedes.map((sede) => (
        <div class="bg-white rounded-2xl shadow-xl border border-gray-200 overflow-hidden hover:shadow-2xl transition-shadow duration-300">
          <!-- Header de la sede -->
          <div class="bg-primary text-white p-6 text-center">
            <h3 class="text-xl font-bold mb-2">{sede.name}</h3>
            <p class="text-primary-100 text-sm">{sede.description}</p>
          </div>

          <!-- Mapa -->
          <div class="aspect-video bg-gray-100">
            <iframe 
              src={sede.mapsEmbed} 
              class="w-full h-full border-0" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade" 
              allowfullscreen
              title={`Mapa de ${sede.name}`}
            ></iframe>
          </div>

          <!-- Información de contacto -->
          <div class="p-6 space-y-4">
            <!-- Dirección -->
            <div class="flex items-start space-x-3">
              <div class="text-primary text-xl">📍</div>
              <div>
                <div class="font-semibold text-gray-800">Dirección</div>
                <div class="text-gray-600 text-sm">{sede.address}</div>
              </div>
            </div>

            <!-- Horarios -->
            <div class="flex items-start space-x-3">
              <div class="text-primary text-xl">🕒</div>
              <div>
                <div class="font-semibold text-gray-800">Horarios</div>
                <div class="text-gray-600 text-sm">{sede.hours}</div>
              </div>
            </div>

            <!-- Teléfono -->
            <div class="flex items-start space-x-3">
              <div class="text-primary text-xl">📞</div>
              <div>
                <div class="font-semibold text-gray-800">Teléfono</div>
                <a href={`tel:${sede.phone}`} class="text-gray-600 text-sm hover:text-primary transition-colors">
                  {sede.phone}
                </a>
              </div>
            </div>

            <!-- WhatsApp -->
            <div class="flex items-start space-x-3">
              <div class="text-primary text-xl">💬</div>
              <div>
                <div class="font-semibold text-gray-800">WhatsApp</div>
                <a 
                  href={`https://wa.me/${getWhatsAppNumberForLink(sede.name.toLowerCase().replace(/[^a-z]/g, ''))}`} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-gray-600 text-sm hover:text-primary transition-colors"
                >
                  {sede.whatsapp}
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start space-x-3">
              <div class="text-primary text-xl">📧</div>
              <div>
                <div class="font-semibold text-gray-800">Email</div>
                <a 
                  href={`mailto:${sede.email}`} 
                  class="text-gray-600 text-sm hover:text-primary transition-colors"
                >
                  {sede.email}
                </a>
              </div>
            </div>

            <!-- Botón de contacto -->
            <div class="pt-4">
              <a 
                href={`https://wa.me/${getWhatsAppNumberForLink(sede.name.toLowerCase().replace(/[^a-z]/g, ''))}?text=Hola! Me interesa conocer más sobre los cursos en la sede ${sede.name}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-primary hover:bg-primary/90 text-white font-semibold py-3 px-6 rounded-lg text-center block transition-colors duration-200"
              >
                Contactar por WhatsApp
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Información adicional -->
    <div class="mt-12 text-center">
      <div class="bg-light-bg rounded-2xl p-8 max-w-4xl mx-auto">
        <h3 class="text-2xl font-bold text-primary mb-4">🚀 ¿Por qué elegir nuestras sedes?</h3>
        <div class="grid md:grid-cols-2 gap-6 text-left">
          <div>
            <h4 class="font-semibold text-gray-800 mb-3">✨ Ventajas de estudiar presencial</h4>
            <ul class="space-y-2 text-gray-600 text-sm">
              <li>• Clases prácticas en talleres equipados</li>
              <li>• Acompañamiento directo de docentes</li>
              <li>• Prácticas reales en instalaciones</li>
              <li>• Networking con otros estudiantes</li>
            </ul>
          </div>
          <div>
            <h4 class="font-semibold text-gray-800 mb-3">🎯 Beneficios adicionales</h4>
            <ul class="space-y-2 text-gray-600 text-sm">
              <li>• Material de estudio incluido</li>
              <li>• Certificaciones reconocidas</li>
              <li>• Bolsa de trabajo exclusiva</li>
              <li>• Seguimiento post-curso</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
