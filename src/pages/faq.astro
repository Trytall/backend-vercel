---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Preguntas Frecuentes | Escuelas IADE" description="Respuestas a las preguntas más frecuentes sobre cursos online y presenciales, inscripción y certificaciones.">
  <Header />
  <main>
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: []
      })}
    </script>
    <section class="relative bg-light-bg text-center overflow-hidden">
      <!-- fondo doodle bajo el título -->
      <div aria-hidden="true" class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute inset-0 opacity-20" style="background-image: url('/images/iade-doodle-red.svg'); background-repeat: repeat; background-size: 120px 120px; background-position: center; will-change: background-position; animation: doodle-drift 60s linear infinite;"></div>
      </div>

      <div class="relative z-[1] max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 min-h-[28vh] flex flex-col justify-center">
        <h1 class="text-3xl lg:text-4xl font-bold text-primary mb-2">Preguntas Frecuentes</h1>
        <p class="text-lg text-gray-700">Encontrá información sobre modalidades, sedes, inscripción, pagos y certificaciones.</p>
      </div>
    </section>
    <div class="pt-12">
      <FAQ hideTitle={true} />
    </div>
  </main>
  <Footer />
</Layout>
