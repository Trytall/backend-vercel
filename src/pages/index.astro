---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BannerCarousel from '../components/BannerCarousel.astro';
import LeadForm from '../components/LeadForm.astro';
import CourseCatalog from '../components/CourseCatalog.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout 
  title="Escuelas IADE | Cursos de Oficio Online y Presenciales"
  description="Aprende un oficio con Escuelas IADE. Ofrecemos cursos técnicos en modalidad online y presencial. ¡Inscríbete hoy!"
>
  <Header />
  <Hero />
  <BannerCarousel />
  <LeadForm />
  <CourseCatalog />
  <FAQ />
  <Footer />
  <WhatsAppButton />

  <script is:inline>
    // Evitar que aparezca el popup de promoción después de completar la inscripción
    document.addEventListener('DOMContentLoaded', function() {
      try {
        const inscripcionCompletada = localStorage.getItem('inscripcion_completada');
        if (inscripcionCompletada === 'true') {
          // Si se completó la inscripción, ocultar cualquier popup de promoción
          // Buscar y ocultar modales/popups comunes
          const modals = document.querySelectorAll('[id*="modal"], [id*="popup"], [class*="modal"], [class*="popup"]');
          modals.forEach(modal => {
            if (modal.style) {
              modal.style.display = 'none';
              modal.style.visibility = 'hidden';
              modal.style.opacity = '0';
            }
          });
          
          // También prevenir que se muestren popups programados
          window.preventPromoPopup = true;
        }
      } catch (e) {
        console.warn('Error verificando estado de inscripción:', e);
      }
    });
  </script>
</Layout> 